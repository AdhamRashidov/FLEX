{
  "name": "@flex/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "node-pg-migrate up -m src/db/migrations --migration-file-language ts",
    "migrate:down": "node-pg-migrate down -m src/db/migrations --migration-file-language ts",
    "migrate:create": "node-pg-migrate create -m src/db/migrations --migration-file-language ts",
    "seed": "tsx src/db/seeds/index.ts"
  },
  "dependencies": {
    "@flex/shared": "*",
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "jsonwebtoken": "^9.0.0",
    "zod": "^3.24.0",
    "dotenv": "^16.4.0",
    "cors": "^2.8.5",
    "helmet": "^8.0.0",
    "node-pg-migrate": "^7.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0"
  }
}
