# ═══════════════════════════════════════════════
# FLEX — Environment Variables
# Ushbu faylni .env ga nusxalab, qiymatlarni to'ldiring
# ═══════════════════════════════════════════════

# ── Database (PostgreSQL) ──────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/flex_db

# ── JWT ────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# ── Telegram ───────────────────────────────────
BOT_TOKEN=123456:ABC-DEF-your-bot-token
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_SECRET=random-webhook-secret

# ── Media Storage ──────────────────────────────
MEDIA_STORAGE=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY=
# R2_SECRET_KEY=
# R2_BUCKET_NAME=flex-media

# ── AI (Telegram kanal import uchun) ───────────
# GEMINI_API_KEY=

# ── Redis (Kesh, Navbat va Rate Limiting) ──────
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# ── App ────────────────────────────────────────
NODE_ENV=development
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
